{
  "name": "eje-turismo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "db:bootstrap": "bash scripts/db/bootstrap.sh",
    "db:migrate": "bash scripts/db/migrate.sh",
    "db:seed": "bash scripts/db/seed.sh",
    "db:reset": "bash scripts/db/reset.sh",
    "db:test:clean": "bash scripts/db/test-clean.sh",
    "db:push": "supabase db push --db-url \"$DATABASE_MIGRATIONS_URL\"",
    "supabase": "supabase",
    "api:types": "openapi-typescript api/openapi.yaml -o src/shared/api/schema.d.ts",
    "api:lint": "redocly lint api/openapi.yaml",
    "api:check": "openapi-typescript api/openapi.yaml -o src/shared/api/schema.d.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:smoke": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:bot": "vitest run tests/bot --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "kysely": "~0.29.9",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "^2.78.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "openapi-typescript": "^7.13.0",
    "supabase": "^3.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
