# Copia este archivo a .env y completa los valores. Nunca subas .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
PRINCIPAL_ADMIN_TELEGRAM_ID=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=
DATABASE_URL=
DATABASE_MIGRATIONS_URL=
# Solo local (PostgreSQL 17 de Homebrew, sin contraseñas). Valores típicos en docs/adr/0014.
PG_BIN=
LOCAL_PG_SUPERUSER_URL=
LOCAL_DB_NAME=
# Opcional: puerto del servidor de pruebas e2e (3100 por defecto)
E2E_PORT=
LOCAL_DATABASE_MIGRATIONS_URL=
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
BLOB_STORAGE_QUOTA_BYTES=
PHOTO_MAX_BYTES=
IDENTITY_ENCRYPTION_KEY=
IDENTITY_HASH_KEY=
BOT_SENSITIVE_DRAFT_TTL_SECONDS=
# RATE_LIMITS: JSON opcional por acción, por ejemplo {"provider_registration":{"limit":5,"windowSeconds":3600}} (D-077)
# IDENTITY_ENCRYPTION_KEY e IDENTITY_HASH_KEY: base64 de 32 bytes (D-078), por ejemplo: openssl rand -base64 32
RATE_LIMITS=
CRON_SECRET=
APP_BASE_URL=
PORT=
